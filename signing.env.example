# PaheBatcher release-signing environment template.
#
# Copy this file to `signing.env` (which is gitignored - NEVER commit it), fill
# in the REAL values locally, and load them into your shell before running
# `assembleRelease`/`bundleRelease`. The repository and CI never contain signing
# material; this example ships dummy placeholders only.
#
# PowerShell, one possible local workflow (adjust to your own practice):
#   Copy-Item signing.env.example signing.env
#   # edit signing.env with the real values, then for the current session:
#   Get-Content signing.env | ForEach-Object {
#     if ($_ -match '^\s*([A-Z_]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] }
#   }
#   .\gradlew.bat assembleRelease bundleRelease
#
# Semantics in pahebatcher/build.gradle.kts (fail-closed):
#   * all four unset  -> release artifacts are built UNSIGNED (default; what CI
#     does - artifacts carry the "-unsigned" suffix on purpose);
#   * all four set    -> release artifacts are signed with your keystore;
#   * partially set   -> Gradle configuration FAILS with an explicit error, so a
#     half-configured shell can never silently emit an unsigned artifact that
#     could be mistaken for a signed release.
#
# Keep the keystore itself outside the repository as well; PB_KEYSTORE_PATH is a
# machine-local absolute path. Values are never logged or embedded in reports.

# Absolute path to the local release keystore (example placeholder only).
PB_KEYSTORE_PATH=C:\path\to\your\release-keystore.p12

# Keystore unlock password (example placeholder only).
PB_KEYSTORE_PASSWORD=change-me-example-only

# Key alias inside the keystore (example placeholder only).
PB_KEY_ALIAS=example-alias

# Key password, if it differs from the keystore password (example placeholder only).
PB_KEY_PASSWORD=change-me-example-only
